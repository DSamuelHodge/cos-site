{{- $pages := slice -}}
{{- range site.Pages -}}
  {{- if and (ne .Kind "taxonomy") (ne .Kind "term") (ne .Kind "404") -}}
    {{- $pages = $pages | append (dict
      "title" .Title
      "permalink" .Permalink
      "path" .RelPermalink
      "kind" .Kind
      "section" .Section
      "date" (.Date.Format "2006-01-02T15:04:05Z07:00")
      "lastmod" (.Lastmod.Format "2006-01-02T15:04:05Z07:00")
      "tags" .Params.tags
      "draft" .Draft
      "summary" .Plain
    ) -}}
  {{- end -}}
{{- end -}}
{{- dict
  "title" site.Title
  "baseURL" site.BaseURL
  "pages" $pages
  | jsonify -}}
