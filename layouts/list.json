{{- $pages := slice -}}
{{- range .Pages -}}
  {{- $pages = $pages | append (dict
    "title" .Title
    "permalink" .Permalink
    "path" .RelPermalink
    "kind" .Kind
    "section" .Section
    "date" (.Date.Format "2006-01-02T15:04:05Z07:00")
  ) -}}
{{- end -}}
{{- dict
  "title" .Title
  "permalink" .Permalink
  "path" .RelPermalink
  "kind" .Kind
  "pages" $pages
  | jsonify -}}
